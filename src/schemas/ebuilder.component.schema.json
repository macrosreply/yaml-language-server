            "small",
            "source",
            "span",
            "strong",
            "sub",
            "summary",
            "sup",
            "table",
            "tbody",
            "td",
            "textarea",
            "tfoot",
            "th",
            "thead",
            "time",
            "tr",
            "track",
            "u",
            "ul",
            "var",
            "video",
            "wbr"
          ]
        },
        "slot": {
          "type": "string"
        },
        "props": {
          "$ref": "#/definitions/componentProps"
        },
        "children": {
          "anyOf": [
            { "type": "string" },
            {
              "description": "Component children",
              "type": "array",
              "items": { "$ref": "#/definitions/child" }
            }
          ]
        }
      }
    },
    "ebChildren": {
      "description": "eBuilder builtin component",
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "eb-config-provider",
            "eb-vnode",
            "eb-button",
            "eb-alert",
            "eb-router-link",
            "eb-brand-logo",
            "eb-breadcrumb",
            "eb-router-prompt",
            "eb-if",
            "eb-hover-overlay",
            "eb-card",
            "eb-col",
            "eb-collapse",
            "eb-descriptions",
            "eb-for-in",
            "eb-form",
            "eb-icon",
            "eb-list",
            "eb-menu",
            "eb-context-menu",
            "eb-modal",
            "eb-router-view",
            "eb-row",
            "eb-tab-content",
            "eb-table",
            "eb-tabs",
            "eb-typography",
            "eb-user-menu",
            "eb-user-unauthorized",
            "eb-image",
            "eb-tree",
            "eb-loading",
            "eb-monaco-viewer",
            "eb-files-drop",
            "eb-pdf-viewer",
            "eb-layout-master",
            "eb-layout-master-tabs",
            "eb-layout-sidebar",
            "eb-layout-sidebar-menu",
            "eb-layout-main",
            "eb-cell-form-item",
            "eb-checkbox",
            "eb-datetime",
            "eb-file",
            "eb-hidden",
            "eb-html-editor",
            "eb-number",
            "eb-password",
            "eb-select",
            "eb-select-search",
            "eb-text",
            "eb-textarea",
            "eb-transfer",
            "eb-radio",
            "eb-monaco-editor"
          ]
        },
        "slot": {
          "type": "string"
        },
        "props": {
          "$ref": "#/definitions/componentProps"
        },
        "children": {
          "anyOf": [
            { "type": "string" },
            {
              "description": "Component children",
              "type": "array",
              "items": { "$ref": "#/definitions/child" }
            }
          ]
        }
      }
    },
    "includedChildren": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        },
        "props": {
          "type": ["object", "string"]
        },
        "children": {
          "anyOf": [
            { "type": "string" },
            {
              "description": "Component children",
              "type": "array",
              "items": { "$ref": "#/definitions/child" }
            }
          ]
        }
      }
    },
    "child": {
      "anyOf": [
        { "$ref": "#/definitions/htmlChildren" },
        { "$ref": "#/definitions/ebChildren" },
        { "$ref": "#/definitions/includedChildren" }
      ]
    },
    "children": {
      "description": "Component children",
      "type": "array",
      "items": {
        "$ref": "#/definitions/child"
      }
    },
    "rootVars": {
      "description": "Component root variables",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        {
          "type": "object"
        }
      ]
    },
    "rootMemo": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/any"
      }
    },
    "rootStore": {
      "description": "Component root store",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "storeKey": {
            "type": "string"
          },
          "initialState": {
            "type": "object"
          }
        }
      }
    },
    "on": {
      "description": "Component event listeners",
      "type": "object",
      "properties": {
        "load": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/emit"
            }
          ]
        },
        "unload": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/emit"
            }
          ]
        },
        "emit": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "debounce": {
                "type": "number"
              },
              "handler": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/definitions/emit"
                  }
                ]
              }
            }
          }
        },
        "watch": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "$ref": "#/definitions/any"
              },
              "handler": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/definitions/emit"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "emit": {
      "description": "Event emit",
      "type": "object",
      "properties": {
        "emit": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "delay": { "type": "number" },
                "checks": { "type": "array", "items": { "type": "string" } },
                "params": { "type": "object" }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "delay": { "type": "number" },
                  "depends": { "type": "array", "items": { "type": "string" } },
                  "checks": { "type": "array", "items": { "type": "string" } },
                  "params": { "type": "object" }
                }
              }
            }
          ]
        }
      }
    },
    "authorize": {
      "description": "Authorize action",
      "type": "object",
      "properties": {
        "policy": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "enum": ["Modify", "Show", "Deny"]
            }
          }
        }
      }
    },
    "componentProps": {
      "description": "Component properties",
      "type": "object",
      "properties": {
        "on": {
          "type": "object",
          "$ref": "#/definitions/emit"
        }
      },
      "additionalProperties": true
    },
    "any": {
      "type": ["string", "number", "boolean", "object", "array", "null"]
    }
  }
}
