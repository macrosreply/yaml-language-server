{
  "$id": "https://ebuilder.macrosreply.info/schemas/ebuilder.component.schema.json",
  "title": "eBuilder - Component",
  "description": "eBuilder - Component",
  "type": "object",
  "properties": {
    "includes": {
      "description": "Root includes",
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "pattern": "^(.)?\\S+\\.(ya?ml|vue)$" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(.)?\\S+\\.(ya?ml|vue)$"
              },
              "async": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "singleton": {
      "description": "Singleton component",
      "type": "boolean"
    },
    "slot": {
      "description": "Root slot",
      "type": "string"
    },
    "style": {
      "description": "Root style",
      "type": "string"
    },
    "children": {
      "$ref": "#/definitions/children"
    },
    "authorize": {
      "$ref": "#/definitions/authorize"
    },
    "rootVars": {
      "$ref": "#/definitions/rootVars"
    },
    "rootMemo": {
      "$ref": "#/definitions/rootMemo"
    },
    "rootStore": {
      "$ref": "#/definitions/rootStore"
    },
    "on": {
      "$ref": "#/definitions/on"
    },
    "formFields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "defaultValue": {
            "$ref": "#/definitions/any"
          },
          "ebFormControl": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": ["string", "null"]
                  },
                  "name": {
                    "type": "string"
                  },
                  "class": {
                    "type": "string"
                  },
                  "spans": {
                    "type": "object",
                    "properties": {
                      "xs": {
                        "type": "number"
                      },
                      "sm": {
                        "type": "number"
                      },
                      "md": {
                        "type": "number"
                      },
                      "lg": {
                        "type": "number"
                      },
                      "xl": {
                        "type": "number"
                      },
                      "xxl": {
                        "type": "number"
                      }
                    }
                  },
                  "props": {
                    "$ref": "#/definitions/any"
                  },
                  "children": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "description": "Component children",
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/child"
                        }
                      }
                    ]
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          },
          "depends": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "on": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "change": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/definitions/emit"
                  }
                ]
              }
            }
          }
        },
        "required": ["name", "ebFormControl"]
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "htmlChildren": {
      "description": "HTML tag",
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "a",
            "abbr",
            "address",
            "area",
            "article",
            "aside",
            "audio",
            "b",
            "bdi",
            "bdo",
